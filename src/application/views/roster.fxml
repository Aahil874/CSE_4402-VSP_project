<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1180.0" styleClass="hero-screen" stylesheets="@grand-prix.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="application.controller.RosterController">
    <fx:define>
        <Image fx:id="rosterAtlas" url="@mascot-roster-atlas-v11.png"/>
    </fx:define>
    <children>
        <VBox alignment="CENTER" maxWidth="1040.0" spacing="16.0" styleClass="glass-panel,roster-panel">
            <padding>
                <Insets bottom="28" left="36" right="36" top="28"/>
            </padding>
            
            <!-- Header Section -->
            <VBox alignment="CENTER" spacing="4.0">
                <Label styleClass="panel-kicker" text="12 ORIGINAL CREATURE ALL-STARS"/>
                <Label styleClass="screen-title" text="BUILD YOUR MASCOT CLUB"/>
                <Label fx:id="playerLabel" styleClass="player-banner" text="BABE RUTH"/>
            </VBox>

            <!-- Main Selection Row -->
            <HBox alignment="CENTER" spacing="28.0">
                <!-- Left Column: Portrait & Dropdown -->
                <VBox alignment="CENTER" prefWidth="280.0" spacing="12.0">
                    <StackPane prefHeight="260.0" prefWidth="280.0" style="-fx-background-color: rgba(6, 12, 38, 0.45); -fx-background-radius: 18px; -fx-border-color: #56f2e3; -fx-border-radius: 18px; -fx-border-width: 2px;">
                        <ImageView fx:id="portraitImage" fitHeight="240.0" fitWidth="260.0" image="$rosterAtlas" preserveRatio="true" smooth="true"/>
                    </StackPane>
                    <ComboBox fx:id="mascotComboBox" prefWidth="280.0" promptText="SELECT MASCOT CAPTAIN"/>
                </VBox>

                <!-- Right Column: Details Box -->
                <VBox alignment="CENTER_LEFT" maxWidth="620.0" minHeight="310.0" prefWidth="620.0" spacing="12.0" styleClass="preview-strip">
                    <Label fx:id="mascotNameLabel" styleClass="preview-title" wrapText="true"/>
                    <Label fx:id="descriptionLabel" styleClass="preview-copy" wrapText="true"/>
                    <Label fx:id="statsLabel" styleClass="stats-label" wrapText="true"/>
                    <Label fx:id="lineupLabel" styleClass="preview-copy" wrapText="true"/>
                </VBox>
            </HBox>

            <!-- Bottom Control Buttons -->
            <HBox alignment="CENTER" spacing="16.0">
                <Button onAction="#handleBack" styleClass="button,secondary-button" text="BACK"/>
                <Button defaultButton="true" onAction="#handleStartGame" styleClass="button,primary-button" text="CUSTOMIZE PITCHING"/>
            </HBox>
        </VBox>
    </children>
</StackPane>
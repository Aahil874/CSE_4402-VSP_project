<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane prefHeight="720" prefWidth="1180" styleClass="hero-screen" stylesheets="@grand-prix.css"
 xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="application.PitchCustomizationController">
 <children><VBox alignment="CENTER" maxWidth="1000" spacing="18" styleClass="glass-panel">
  <padding><Insets bottom="28" left="38" right="38" top="28"/></padding>
  <Label styleClass="panel-kicker" text="PITCH LAB"/>
  <Label styleClass="screen-title" text="CUSTOMIZE YOUR ACE"/>
  <GridPane alignment="CENTER" hgap="16" vgap="14">
   <Label text="DELIVERY STYLE" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
   <ComboBox fx:id="styleBox" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
   <Label text="PITCH 1" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
   <ComboBox fx:id="pitchOne" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
   <Label text="PITCH 2" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
   <ComboBox fx:id="pitchTwo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
   <Label text="PITCH 3" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
   <ComboBox fx:id="pitchThree" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
   <Label text="PITCH 4" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
   <ComboBox fx:id="pitchFour" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
  </GridPane>
  <Label fx:id="detailsLabel" maxWidth="900" styleClass="preview-copy" textAlignment="CENTER" wrapText="true"/>
  <Label fx:id="lineupLabel" maxWidth="920" styleClass="stats-label" textAlignment="CENTER" wrapText="true"/>
  <HBox alignment="CENTER" spacing="16">
   <Button onAction="#handleBack" styleClass="button,secondary-button" text="BACK"/>
   <Button defaultButton="true" onAction="#handlePlay" styleClass="button,primary-button" text="PLAY BALL"/>
  </HBox>
 </VBox></children>
</StackPane>

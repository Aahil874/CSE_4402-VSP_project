<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1180.0" styleClass="leaderboard-screen"
            stylesheets="@grand-prix.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.LeaderboardController">
    <top>
        <VBox alignment="CENTER" spacing="5.0">
            <padding>
                <Insets bottom="15.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <Label styleClass="panel-kicker" text="HALL OF CHAMPIONS" />
            <Label styleClass="screen-title" text="CHAMPIONSHIP STANDINGS" />
            <Label fx:id="statusLabel" styleClass="leaderboard-status"
                   text="3 POINTS FOR A WIN • 1 POINT FOR A TIE" />
        </VBox>
    </top>

    <center>
        <TableView fx:id="scoreTable" styleClass="grand-table">
            <columns>
                <TableColumn fx:id="rankColumn" minWidth="64.0" text="#" />
                <TableColumn fx:id="playerColumn" minWidth="145.0" text="PLAYER" />
                <TableColumn fx:id="mascotColumn" minWidth="160.0" text="MASCOT" />
                <TableColumn fx:id="gamesColumn" minWidth="80.0" text="GAMES" />
                <TableColumn fx:id="recordColumn" minWidth="100.0" text="W-L-T" />
                <TableColumn fx:id="pointsColumn" minWidth="80.0" text="PTS" />
                <TableColumn fx:id="runsColumn" minWidth="95.0" text="RUNS" />
                <TableColumn fx:id="homersColumn" minWidth="80.0" text="HR" />
                <TableColumn fx:id="bestColumn" minWidth="95.0" text="BEST" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="10.0" left="38.0" right="38.0" />
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <Button onAction="#handleBack" styleClass="button,primary-button" text="BACK TO PADDOCK" />
        </HBox>
    </bottom>
</BorderPane>

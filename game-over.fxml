<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1180.0" styleClass="hero-screen"
           stylesheets="@grand-prix.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="application.GameOverController">
    <children>
        <VBox alignment="CENTER" maxWidth="820.0" spacing="10.0" styleClass="glass-panel,result-panel">
            <padding>
                <Insets bottom="24.0" left="42.0" right="42.0" top="24.0" />
            </padding>
            <Label styleClass="panel-kicker" text="CHECKERED FLAG" />
            <Label fx:id="resultLabel" styleClass="result-title" text="VICTORY LAP!" />
            <ImageView fx:id="resultMascotImage" fitHeight="112.0" fitWidth="160.0"
                       preserveRatio="true" smooth="true" />
            <Label fx:id="playerLabel" styleClass="player-banner" text="PLAYER 1" />
            <HBox alignment="CENTER" spacing="12.0">
                <Label fx:id="mascotLabel" styleClass="feature-chip" text="TURBO TANUKI" />
                <Label fx:id="difficultyLabel" styleClass="feature-chip" text="EASY" />
            </HBox>

            <HBox alignment="CENTER" spacing="24.0">
                <VBox alignment="CENTER" styleClass="result-score-card,win-score">
                    <Label styleClass="result-caption" text="YOU" />
                    <Label fx:id="scoreLabel" styleClass="result-score" text="0" />
                </VBox>
                <Label styleClass="versus-label" text="VS" />
                <VBox alignment="CENTER" styleClass="result-score-card,rival-score-card">
                    <Label styleClass="result-caption" text="RIVAL" />
                    <Label fx:id="rivalScoreLabel" styleClass="result-score" text="0" />
                </VBox>
            </HBox>

            <GridPane alignment="CENTER" hgap="36.0" vgap="12.0">
                <Label text="HITS" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="hitsLabel" styleClass="stat-value" text="0"
                       GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="HOME RUNS" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="homeRunsLabel" styleClass="stat-value" text="0"
                       GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="INNINGS" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="inningsLabel" styleClass="stat-value" text="3"
                       GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="MAX COMBO" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Label fx:id="comboLabel" styleClass="stat-value" text="x0"
                       GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="1B / 2B / 3B" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label fx:id="hitBreakdownLabel" styleClass="stat-value" text="0 / 0 / 0"
                       GridPane.columnIndex="3" GridPane.rowIndex="0" />
                <Label text="WALKS / K" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Label fx:id="disciplineLabel" styleClass="stat-value" text="0 / 0"
                       GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </GridPane>

            <Label fx:id="opponentLabel" styleClass="feature-chip"
                   text="GRAND PRIX RIVALS • 0 SEC" />
            <Label fx:id="saveStatusLabel" minHeight="26.0" styleClass="status-banner" />
            <Button fx:id="saveButton" maxWidth="340.0" onAction="#handleSaveScore"
                    styleClass="button,primary-button" text="SAVE GRAND PRIX RESULT" />
            <HBox alignment="CENTER" spacing="12.0">
                <Button onAction="#handlePlayAgain" text="REMATCH" />
                <Button onAction="#handleLeaderboard" text="LEADERBOARD" />
                <Button onAction="#handleMainMenu" styleClass="button,secondary-button" text="MAIN MENU" />
            </HBox>
        </VBox>
    </children>
</StackPane>

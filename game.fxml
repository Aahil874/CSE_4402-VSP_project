<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1280.0" styleClass="game-root"
            stylesheets="@grand-prix.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.GameController">
    <top>
        <VBox spacing="0.0">
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="race-scoreboard">
                <padding>
                    <Insets bottom="7.0" left="22.0" right="22.0" top="7.0" />
                </padding>
                <Label styleClass="scoreboard-logo" text="MBGP" />
                <Label text="PLAYER" />
                <Label fx:id="playerLabel" styleClass="hud-value" text="PLAYER 1" />
                <Label fx:id="mascotLabel" styleClass="hud-accent" text="TURBO TANUKI" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="inningLabel" styleClass="difficulty-pill" text="INNING 1/3" />
                <Label fx:id="phaseLabel" styleClass="phase-pill" text="TOP: YOU PITCH" />
                <Label fx:id="difficultyLabel" styleClass="difficulty-pill" text="EASY" />
            </HBox>
            <HBox alignment="CENTER" spacing="12.0" styleClass="score-strip">
                <padding>
                    <Insets bottom="5.0" left="22.0" right="22.0" top="5.0" />
                </padding>
                <Label text="YOU" />
                <Label fx:id="playerRunsLabel" styleClass="run-value" text="0" />
                <Label text="RIVAL" />
                <Label fx:id="rivalRunsLabel" styleClass="run-value,rival-run" text="0" />
                <Label text="B" />
                <Label fx:id="ballsLabel" styleClass="count-value" text="0" />
                <Label text="S" />
                <Label fx:id="strikesLabel" styleClass="count-value" text="0" />
                <Label text="O" />
                <Label fx:id="outsLabel" styleClass="count-value" text="0" />
                <Label fx:id="comboLabel" styleClass="combo-pill" text="x0" />
                <Label fx:id="baseDiamondLabel" alignment="CENTER"
                       minWidth="48.0" styleClass="base-diamond" text="◇&#10;◇ ◇" />
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane alignment="CENTER" styleClass="canvas-shell">
            <BorderPane.margin>
                <Insets bottom="7.0" left="24.0" right="24.0" top="9.0" />
            </BorderPane.margin>
            <Canvas fx:id="gameCanvas" focusTraversable="true" height="650.0"
                    styleClass="game-canvas" width="1120.0" />
        </StackPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="7.0" styleClass="control-deck">
            <padding>
                <Insets bottom="12.0" left="22.0" right="22.0" top="8.0" />
            </padding>
            <Label fx:id="statusLabel" styleClass="status-banner"
                   text="MOVE THE MOUSE TO AIM, THEN LEFT-CLICK TO PITCH" />
            <Label fx:id="pitchMetricsLabel" styleClass="pitch-metrics"
                   text="READY • PITCH SPEED • EXIT VELOCITY • LAUNCH ANGLE" />
            <Label styleClass="mouse-help"
                   text="MOUSE X = AIM ACROSS PLATE + PLAYER MOVEMENT   |   LEFT CLICK = PITCH / NEXT BALL   |   RIGHT CLICK = SWING" />
            <HBox alignment="CENTER" spacing="9.0">
                <Label styleClass="deck-label" text="TURBO" />
                <ProgressBar fx:id="turboMeter" prefWidth="330.0" progress="0.0" />
                <Label fx:id="turboLabel" minWidth="105.0" styleClass="turbo-value" text="0%" />
                <Label styleClass="deck-label" text="PITCH / TIMING" />
                <Button onAction="#handleLeft" text="&#9664; [A]" />
                <Label fx:id="pitchTypeLabel" minWidth="155.0" styleClass="pitch-value"
                       text="FOUR-SEAM FASTBALL" />
                <Button onAction="#handleRight" text="[D] &#9654;" />
                <Label fx:id="aimLabel" minWidth="115.0" styleClass="aim-value" text="ZONE 6" />
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
                <Button onAction="#handleAimUp" text="AIM UP [W]" />
                <Button onAction="#handleAimDown" text="AIM DOWN [S]" />
                <Button fx:id="primaryButton" onAction="#handlePrimaryAction"
                        styleClass="button,primary-button" text="THROW [LEFT CLICK / P]" />
                <Button fx:id="swingButton" onAction="#handleSwing"
                        styleClass="button,swing-button" text="SWING [RIGHT CLICK / SPACE]" />
                <Button fx:id="pauseButton" onAction="#handlePause" text="PAUSE [ESC]" />
                <Button onAction="#handleMainMenu" styleClass="button,danger-button" text="QUIT" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>

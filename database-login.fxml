<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1180.0" styleClass="login-screen"
           stylesheets="@grand-prix.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="application.DatabaseLoginController">
    <children>
        <HBox alignment="CENTER" maxWidth="940.0" spacing="0.0" styleClass="login-shell">
            <VBox alignment="CENTER_LEFT" prefWidth="430.0" spacing="14.0" styleClass="login-art-panel">
                <padding>
                    <Insets bottom="46.0" left="44.0" right="44.0" top="46.0" />
                </padding>
                <Label styleClass="eyebrow-label" text="WELCOME TO" />
                <Label styleClass="login-logo" text="MASCOT&#10;BASEBALL" />
                <Label styleClass="grand-prix-title" text="GRAND PRIX" />
                <Label styleClass="hero-copy"
                       text="The game connects automatically to the local MySQL 8 database and creates its schema when needed."
                       wrapText="true" />
                <Label styleClass="feature-chip" text="JAVA 21 + JAVAFX 21 + JDBC" />
            </VBox>

            <VBox alignment="CENTER" prefWidth="510.0" spacing="17.0" styleClass="login-form-panel">
                <padding>
                    <Insets bottom="42.0" left="48.0" right="48.0" top="42.0" />
                </padding>
                <Label styleClass="panel-kicker" text="DATABASE GARAGE" />
                <Label styleClass="panel-title" text="MYSQL 8 CONNECTION" />

                <GridPane hgap="14.0" vgap="13.0">
                    <Label styleClass="field-label" text="HOST"
                           GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField editable="false" focusTraversable="false" text="localhost"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label styleClass="field-label" text="PORT"
                           GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField editable="false" focusTraversable="false" text="3306"
                               GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label styleClass="field-label" text="DATABASE"
                           GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField editable="false" focusTraversable="false"
                               text="mascot_baseball_grand_prix"
                               GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label styleClass="field-label" text="JDBC USER"
                           GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField editable="false" focusTraversable="false" text="root"
                               GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </GridPane>

                <Label fx:id="statusLabel" minHeight="30.0" styleClass="feedback-label"
                       text="CONNECTING AUTOMATICALLY WITH THE LOCAL JDBC ACCOUNT..."
                       wrapText="true" />
                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="connectButton" defaultButton="true"
                            onAction="#handleConnect" styleClass="button,primary-button"
                            text="RETRY CONNECTION" />
                    <Button fx:id="backButton" onAction="#handleBack" text="BACK" />
                </HBox>
                <Label styleClass="tiny-help"
                       text="JAVA 21 • JAVAFX 21 • MYSQL CONNECTOR/J 8 • USER ROOT" />
            </VBox>
        </HBox>
    </children>
</StackPane>
